# Node 24+: node --env-file=.env server/index.mjs --production
PORT=5173
APP_ORIGIN=http://localhost:5173
# Store this directory and its encryption.key together in your private backup.
# DATA_DIR=C:/private/folio-data

# SMS sign-in uses Twilio Verify. No SMS is simulated when unconfigured.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# Approved FHIR R4 provider: only this account can sync the mapped patient.
# FHIR_URL=https://your-approved-provider.example/fhir/
# FHIR_TOKEN=
# FHIR_PATIENT_ID=
# FHIR_ACCOUNT_EMAIL=
